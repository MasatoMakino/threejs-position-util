{
  "name": "@masatomakino/threejs-position-util",
  "version": "0.5.2",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "exports": {
    ".": {
      "default": {
        "types": "./esm/index.d.ts",
        "default": "./esm/index.js"
      }
    }
  },
  "types": "./esm/index.d.ts",
  "files": [
    "esm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://MasatoMakino@github.com/MasatoMakino/threejs-position-util.git"
  },
  "author": "MasatoMakino <unagiinu.g@gmail.com>",
  "license": "MIT",
  "keywords": [
    "threejs"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@masatomakino/demo-showcase": "^0.1.2",
    "@types/node": "^26.6.5",
    "@types/three": "^0.187.0",
    "@vitest/coverage-istanbul": "^5.0.5",
    "jsdom": "^30.1.3",
    "three": "^0.187.0",
    "typescript": "^7.0.2",
    "vitest": "5.1.0"
  },
  "peerDependencies": {
    "three": ">=0.126.0 <1.0.0"
  },
  "scripts": {
    "test": "vitest --run",
    "test:watch": "vitest",
    "coverage": "vitest --run --coverage",
    "pre-commit": "biome format --write --no-errors-on-unmatched --files-ignore-unknown=true",
    "pre-push": "biome ci . && pnpm test",
    "start:dev": "pnpm run server & pnpm run watch:tsc",
    "build": "pnpm run buildTS && pnpm run demo",
    "demo": "demo-showcase build --distDir ./docs/demo --body '<canvas id=\"webgl-canvas\" width=\"1920\" height=\"1080\"></canvas>'",
    "buildTS": "tsc",
    "server": "demo-showcase dev --host 0.0.0.0 --port 3456 --body '<canvas id=\"webgl-canvas\" width=\"1920\" height=\"1080\"></canvas>'",
    "watch:tsc": "tsc -W --incremental"
  },
  "description": "measuring geometry positions for three.js",
  "bugs": {
    "url": "https://github.com/MasatoMakino/threejs-position-util/issues"
  },
  "homepage": "https://github.com/MasatoMakino/threejs-position-util#readme",
  "directories": {
    "doc": "docs",
    "lib": "lib"
  }
}
