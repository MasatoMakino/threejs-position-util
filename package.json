{
  "name": "@masatomakino/threejs-position-util",
  "version": "0.5.1",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "exports": {
    ".": {
      "default": {
        "types": "./esm/index.d.ts",
        "default": "./esm/index.js"
      }
    }
  },
  "types": "./esm/index.d.ts",
  "files": [
    "esm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://MasatoMakino@github.com/MasatoMakino/threejs-position-util.git"
  },
  "author": "MasatoMakino <unagiinu.g@gmail.com>",
  "license": "MIT",
  "keywords": [
    "threejs"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@masatomakino/gulptask-demo-page": "^0.10.0",
    "@types/node": "^25.2.0",
    "@types/three": "^0.183.1",
    "@vitest/coverage-istanbul": "^3.0.2",
    "browser-sync": "^3.0.2",
    "jsdom": "^26.0.0",
    "three": "^0.183.1",
    "typescript": "^5.5.3",
    "vitest": "3.2.4"
  },
  "peerDependencies": {
    "three": ">=0.126.0 <1.0.0"
  },
  "scripts": {
    "test": "vitest --run",
    "test:watch": "vitest",
    "coverage": "vitest --run --coverage",
    "pre-commit": "biome format --write --no-errors-on-unmatched --files-ignore-unknown=true",
    "pre-push": "biome ci . && pnpm test",
    "start:dev": "pnpm run server & pnpm run watch:tsc & pnpm run watch:demo",
    "build": "pnpm run buildTS && pnpm run demo",
    "demo": "gulptask-demo-page --body '<canvas id=\"webgl-canvas\" width=\"1920\" height=\"1080\"></canvas>'",
    "buildTS": "tsc",
    "server": "browser-sync ./docs/demo -w --no-open",
    "watch:demo": "pnpm run demo -W",
    "watch:tsc": "tsc -W --incremental"
  },
  "description": "measuring geometry positions for three.js",
  "bugs": {
    "url": "https://github.com/MasatoMakino/threejs-position-util/issues"
  },
  "homepage": "https://github.com/MasatoMakino/threejs-position-util#readme",
  "directories": {
    "doc": "docs",
    "lib": "lib"
  }
}
